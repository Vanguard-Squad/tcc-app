<% content_for :title, "Reordenar paradas" %>

<main class="page page-narrow">
  <%= back_link "Minha rota", drivers_route_path %>
  <h1>Reordenar paradas</h1>

  <% if @route.nil? %>
    <p>Você ainda não tem uma rota atribuída.</p>
  <% else %>
    <p class="page-subtitle">Arraste as paradas para a ordem em que você passa por elas.</p>

    <%= form_with url: drivers_route_path, method: :patch, local: true, class: "form", data: { controller: "stop-reorder" } do %>
      <ul class="reorder-list" data-stop-reorder-target="list">
        <% @stops.each do |stop| %>
          <li
            class="stop-row"
            data-stop-reorder-target="item"
            data-id="<%= stop.id %>"
            draggable="true"
            data-action="dragstart->stop-reorder#dragStart dragover->stop-reorder#dragOver drop->stop-reorder#drop"
          >
            <span class="drag-handle" aria-hidden="true">⋮⋮</span>
            <span class="stop-row-title"><%= stop.step %>. <%= stop.address.label_with_city %></span>
          </li>
        <% end %>
      </ul>

      <div data-stop-reorder-target="hiddenFields"></div>

      <%= submit_tag "Salvar nova ordem", class: "btn btn-primary btn-block" %>
    <% end %>
  <% end %>
</main>
