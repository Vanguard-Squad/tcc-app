<% content_for :title, "Minha rota" %>

<main class="page">
  <% if @route.nil? %>
    <h1>Minha rota</h1>
    <section class="panel empty-state">
      <%= icon(:route, size: 36, css: "empty-icon") %>
      <strong>Você ainda não tem uma rota</strong>
      Fale com a secretaria para receber um ônibus e uma rota.
    </section>
  <% else %>
    <%
      active_trip = current_user.driver.active_trip
      map_stops = route_stops_for_map(@stops, direction: active_trip&.direction)
      bus = active_trip&.latitude ? { lat: active_trip.latitude, lng: active_trip.longitude } : {}
    %>

    <div class="page-header">
      <div>
        <h1><%= @route.name %></h1>
        <p class="page-subtitle">
          <%= plate(@vehicle.license_plate) %>
          <% if active_trip %>
            Viagem de <%= active_trip.outbound? ? "ida" : "volta" %> desde as <%= l(active_trip.started_at, format: "%H:%M") %>
          <% end %>
        </p>
      </div>
      <div class="page-header-actions">
        <%= link_to "Reordenar paradas", edit_drivers_route_path, class: "btn btn-secondary" %>
        <%= link_to passengers_drivers_route_path, class: "btn btn-secondary" do %><%= icon(:passengers, size: 18) %> Passageiros<% end %>
      </div>
    </div>

    <section class="trip-hero <%= "is-live" if active_trip %>">
      <% if active_trip %>
        <div class="trip-controls"
             data-controller="trip-tracker"
             data-trip-tracker-url-value="<%= drivers_trip_position_path %>"
             data-trip-tracker-stops-value="<%= map_stops.to_json %>">
          <div>
            <p class="trip-hero-kicker"><span class="live-dot" aria-hidden="true"></span> Enviando a posição do ônibus</p>
            <p class="field-hint" data-trip-tracker-target="status">Escolha como enviar a posição: GPS do celular ou simulação do trajeto.</p>
          </div>
          <div class="trip-controls-source">
            <button type="button" class="btn btn-primary" data-action="trip-tracker#startGps"><%= icon(:pin, size: 18) %> Usar GPS</button>
            <button type="button" class="btn btn-secondary" data-action="trip-tracker#startSimulation">Simular trajeto</button>
            <button type="button" class="btn btn-secondary" data-action="trip-tracker#stopSending">Pausar</button>
          </div>
        </div>
        <div class="trip-hero-actions trip-hero-footer">
          <%= link_to drivers_trip_qr_code_path, class: "btn btn-secondary" do %><%= icon(:qr, size: 18) %> QR code de check-in<% end %>
          <%= button_to "Finalizar viagem", drivers_trip_path, method: :delete, class: "btn btn-danger", form_class: "inline-form",
                form: { data: { turbo_confirm: "Finalizar a viagem? Os alunos deixam de ver o ônibus no mapa." } } %>
        </div>
      <% else %>
        <p class="trip-hero-kicker">Nenhuma viagem em andamento</p>
        <p class="trip-hero-status">Ao iniciar, os alunos passam a ver o ônibus no mapa.</p>
        <div class="trip-hero-actions">
          <%= button_to "Iniciar ida", drivers_trip_path, params: { direction: "outbound" }, class: "btn btn-primary btn-large", form_class: "inline-form" %>
          <%= button_to "Iniciar volta", drivers_trip_path, params: { direction: "return" }, class: "btn btn-secondary btn-large", form_class: "inline-form" %>
        </div>
      <% end %>
    </section>

    <div class="route-tracker"
         data-controller="route-map"
         data-route-map-stops-value="<%= map_stops.to_json %>"
         data-route-map-vehicle-id-value="<%= @vehicle.id %>"
         data-route-map-trip-active-value="<%= active_trip.present? %>"
         data-route-map-bus-value="<%= bus.to_json %>">
      <div class="route-map" id="route-map" data-route-map-target="map"></div>
      <%= render "shared/route_panel", stops: map_stops, trip: active_trip %>
    </div>
  <% end %>
</main>
