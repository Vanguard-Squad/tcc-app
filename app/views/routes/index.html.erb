<% content_for :title, "Rotas" %>

<main class="page">
  <div class="page-header">
    <h1>Rotas</h1>
    <%= link_to "Cadastrar rota", new_route_path, class: "btn btn-primary btn-inline" %>
  </div>

  <table class="data-table">
    <thead>
      <tr>
        <th>Nome</th>
        <th>Paradas</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @routes.each do |route| %>
        <tr>
          <td><%= route.name %></td>
          <td>
            <% if route.stops.any? %>
              <%= route.stops.map { |stop| "#{stop.step}. #{stop.address.label_with_city}" }.join(" → ") %>
            <% else %>
              Nenhuma parada cadastrada
            <% end %>
          </td>
          <td><%= link_to "Editar", edit_route_path(route) %></td>
        </tr>
      <% end %>
      <% if @routes.empty? %>
        <tr><td colspan="3">Nenhuma rota cadastrada ainda.</td></tr>
      <% end %>
    </tbody>
  </table>
</main>
