<% new_address = form.object.address&.new_record? ? form.object.address : Address.new %>
<% start_with_new_address = stop_addresses.empty? || form.object.address&.new_record? %>
<div class="stop-row" data-route-stops-target="stop" <%= "hidden" if form.object.marked_for_destruction? %>>
  <% if form.object.persisted? %>
    <%= form.hidden_field :_destroy, value: form.object.marked_for_destruction? ? "1" : "0", data: { "destroy-field": true } %>
  <% end %>

  <div class="stop-row-header">
    <span class="stop-row-title">Parada</span>
    <button type="button" data-action="route-stops#remove" class="link-button">Remover</button>
  </div>

  <div class="field" data-controller="toggle-fields" data-toggle-fields-mode-value="<%= start_with_new_address ? "new" : "existing" %>">
    <%= form.label :address_id, "Endereço da parada" %>

    <div data-toggle-fields-target="existing">
      <%= form.select :address_id,
            options_from_collection_for_select(stop_addresses, :id, :label_with_city, form.object.address_id),
            { include_blank: "Selecione um endereço já usado" } %>
      <p class="field-hint">
        Não encontrou o endereço?
        <button type="button" data-action="toggle-fields#showNew" class="link-button">Cadastrar novo endereço</button>
      </p>
    </div>

    <fieldset data-toggle-fields-target="new" hidden class="nested-fieldset">
      <legend>Novo endereço</legend>

      <%= form.fields_for :address, new_address do |address_form| %>
        <div data-controller="cep-lookup">
          <div class="field">
            <%= address_form.label :zip_code, "CEP" %>
            <%= address_form.text_field :zip_code, required: true,
                  data: { "cep-lookup-target": "zipCode", action: "input->cep-lookup#lookup" } %>
            <p class="field-hint">Digite o CEP para preencher rua, bairro e cidade automaticamente.</p>
          </div>

          <div class="field">
            <%= address_form.label :street, "Rua" %>
            <%= address_form.text_field :street, required: true, data: { "cep-lookup-target": "street" } %>
          </div>

          <div class="field-row">
            <div class="field">
              <%= address_form.label :number, "Número" %>
              <%= address_form.number_field :number, required: true %>
            </div>

            <div class="field">
              <%= address_form.label :complement, "Complemento" %>
              <%= address_form.text_field :complement %>
            </div>
          </div>

          <div class="field">
            <%= address_form.label :neighborhood, "Bairro" %>
            <%= address_form.text_field :neighborhood, required: true, data: { "cep-lookup-target": "neighborhood" } %>
          </div>

          <div class="field-row">
            <div class="field">
              <%= address_form.label :city, "Cidade" %>
              <%= address_form.text_field :city, required: true, data: { "cep-lookup-target": "city" } %>
            </div>

            <div class="field">
              <%= address_form.label :country, "País" %>
              <%= address_form.text_field :country, required: true %>
            </div>
          </div>
        </div>
      <% end %>

      <p class="field-hint">
        <button type="button" data-action="toggle-fields#showExisting" class="link-button">Selecionar endereço existente</button>
      </p>
    </fieldset>
  </div>
</div>
