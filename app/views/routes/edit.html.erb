<% content_for :title, "Editar rota" %>

<main class="page page-narrow">
  <%= back_link "Rotas", routes_path %>
  <h1>Editar rota <%= @route.name_was %></h1>

  <section class="panel">
    <%= render "form", route: @route, stop_addresses: @stop_addresses, url: route_path(@route), submit_label: "Salvar rota" %>
  </section>
</main>
