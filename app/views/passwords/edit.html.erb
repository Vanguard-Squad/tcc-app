<% content_for :title, "Nova senha" %>

<main class="page page-narrow">
  <div class="page-header">
    <div>
      <h1><%= current_user.must_change_password? ? "Crie sua senha" : "Trocar senha" %></h1>
      <% if current_user.must_change_password? %>
        <p class="page-subtitle">Você entrou com a senha provisória enviada pela secretaria. Crie uma senha só sua para continuar.</p>
      <% end %>
    </div>
  </div>

  <section class="panel">
    <%= form_with url: password_path, method: :patch, local: true, class: "auth-form" do |form| %>
      <div class="field">
        <%= form.label :current_password, current_user.must_change_password? ? "Senha provisória" : "Senha atual" %>
        <%= form.password_field :current_password, required: true, autocomplete: "current-password", autofocus: true %>
      </div>

      <div class="field">
        <%= form.label :password, "Nova senha" %>
        <%= form.password_field :password, required: true, minlength: 8, autocomplete: "new-password",
              pattern: "(?=.*[a-z])(?=.*[A-Z])(?=.*[^A-Za-z0-9\\s]).{8,}",
              title: "Mínimo de 8 caracteres, com letra maiúscula, minúscula e caractere especial" %>
        <p class="field-hint">Mínimo de 8 caracteres, com letra maiúscula, minúscula e caractere especial.</p>
      </div>

      <div class="field">
        <%= form.label :password_confirmation, "Confirmar nova senha" %>
        <%= form.password_field :password_confirmation, required: true, minlength: 8, autocomplete: "new-password" %>
      </div>

      <%= form.submit "Salvar senha", class: "btn btn-primary" %>
    <% end %>
  </section>
</main>
