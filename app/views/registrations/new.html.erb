<% content_for :title, "Criar conta" %>

<main class="auth-page">
  <div class="auth-card">
    <p class="wizard-step">Etapa 1 de 2 &middot; Sua conta</p>
    <h1>Criar conta</h1>

    <%= render "shared/form_errors", object: @user %>

    <%= form_with model: @user, url: registrations_path, local: true, class: "auth-form" do |form| %>
      <div class="field">
        <%= form.label :name, "Nome" %>
        <%= form.text_field :name, required: true, autofocus: true %>
      </div>

      <div class="field">
        <%= form.label :username, "Usuário" %>
        <%= form.text_field :username, required: true %>
      </div>

      <div class="field">
        <%= form.label :password, "Senha" %>
        <%= form.password_field :password, required: true, minlength: 8 %>
      </div>

      <div class="field">
        <%= form.label :password_confirmation, "Confirmar senha" %>
        <%= form.password_field :password_confirmation, required: true, minlength: 8 %>
      </div>

      <%= form.submit "Continuar", class: "btn btn-primary" %>
    <% end %>

    <p class="auth-alt-action">
      Já tem conta?
      <%= link_to "Entrar", login_path, class: "btn btn-secondary" %>
    </p>
  </div>
</main>
