<nav class="sidebar" aria-label="Menu principal">
  <div class="sidebar-brand">
    <span class="brand-mark" aria-hidden="true"></span>
    <div>
      <strong><%= current_company.name %></strong>
      <span><%= role_label(current_user.role) %></span>
    </div>
  </div>

  <% items = navigation_items %>
  <div class="nav-line" style="--nav-count: <%= items.size %>">
    <% items.each do |item| %>
      <%= nav_item(item.label, item.path, item.icon, active: item.active) %>
    <% end %>
  </div>

  <div class="sidebar-user">
    <%= avatar(current_user, size: :sm) %>
    <span class="sidebar-user-name"><%= current_user.name %></span>
    <%= button_to logout_path, method: :delete, class: "icon-button", form_class: "inline-form", title: "Sair", "aria-label": "Sair" do %>
      <%= icon(:logout, size: 18) %>
    <% end %>
  </div>
</nav>
