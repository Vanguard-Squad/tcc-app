<% content_for :title, "Cadastrar motorista" %>

<%= render "shared/nav" %>

<main class="page page-narrow">
  <h1>Cadastrar motorista</h1>

  <%= render "shared/form_errors", object: @user %>

  <%= form_with model: @user, url: member_drivers_path, local: true, class: "auth-form" do |form| %>
    <div class="field">
      <%= form.label :name, "Nome" %>
      <%= form.text_field :name, required: true, autofocus: true %>
    </div>

    <div class="field">
      <%= form.label :username, "Usuário" %>
      <%= form.text_field :username, required: true %>
    </div>

    <div class="field">
      <%= form.label :password, "Senha" %>
      <%= form.password_field :password, required: true, minlength: 8 %>
    </div>

    <div class="field">
      <%= form.label :password_confirmation, "Confirmar senha" %>
      <%= form.password_field :password_confirmation, required: true, minlength: 8 %>
    </div>

    <%= form.fields_for :driver do |driver_form| %>
      <div class="field">
        <%= driver_form.label :birthdate, "Data de nascimento" %>
        <%= driver_form.date_field :birthdate, required: true %>
      </div>

      <div class="field">
        <%= driver_form.label :drive_license, "CNH" %>
        <%= driver_form.text_field :drive_license, required: true %>
      </div>
    <% end %>

    <%= form.submit "Cadastrar", class: "btn btn-primary" %>
  <% end %>
</main>
