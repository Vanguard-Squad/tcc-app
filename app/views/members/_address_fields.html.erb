<div data-controller="cep-lookup">
  <div class="field">
    <%= form.label :zip_code, "CEP" %>
    <%= form.text_field :zip_code, required: true,
          data: { "cep-lookup-target": "zipCode", action: "input->cep-lookup#lookup" } %>
    <p class="field-hint">Digite o CEP para preencher rua, bairro e cidade automaticamente.</p>
  </div>

  <div class="field">
    <%= form.label :street, "Rua" %>
    <%= form.text_field :street, required: true, data: { "cep-lookup-target": "street" } %>
  </div>

  <div class="field-row">
    <div class="field">
      <%= form.label :number, "Número" %>
      <%= form.number_field :number, required: true %>
    </div>

    <div class="field">
      <%= form.label :complement, "Complemento" %>
      <%= form.text_field :complement %>
    </div>
  </div>

  <div class="field">
    <%= form.label :neighborhood, "Bairro" %>
    <%= form.text_field :neighborhood, required: true, data: { "cep-lookup-target": "neighborhood" } %>
  </div>

  <div class="field-row">
    <div class="field">
      <%= form.label :city, "Cidade" %>
      <%= form.text_field :city, required: true, data: { "cep-lookup-target": "city" } %>
    </div>

    <div class="field">
      <%= form.label :country, "País" %>
      <%= form.text_field :country, required: true %>
    </div>
  </div>
</div>
