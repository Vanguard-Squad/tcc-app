<%# Nome, e-mail e senha. Na edição a senha é opcional: em branco mantém a atual. %>
<% editing = form.object.persisted? %>

<h3 class="form-section form-section-first">Acesso</h3>

<div class="field">
  <%= form.label :name, "Nome" %>
  <%= form.text_field :name, required: true, autofocus: true %>
</div>

<div class="field">
  <%= form.label :email, "E-mail" %>
  <%= form.email_field :email, required: true %>
</div>

<div class="field">
  <%= form.label :password, editing ? "Nova senha" : "Senha" %>
  <%= form.password_field :password, required: !editing, minlength: 8, autocomplete: "new-password",
        pattern: "(?=.*[a-z])(?=.*[A-Z])(?=.*[^A-Za-z0-9\\s]).{8,}",
        title: "Mínimo de 8 caracteres, com letra maiúscula, minúscula e caractere especial" %>
  <p class="field-hint">
    Mínimo de 8 caracteres, com letra maiúscula, minúscula e caractere especial.
    <% if editing %>Deixe em branco para manter a senha atual.<% end %>
  </p>
</div>

<div class="field">
  <%= form.label :password_confirmation, editing ? "Confirmar nova senha" : "Confirmar senha" %>
  <%= form.password_field :password_confirmation, required: !editing, minlength: 8, autocomplete: "new-password" %>
</div>
